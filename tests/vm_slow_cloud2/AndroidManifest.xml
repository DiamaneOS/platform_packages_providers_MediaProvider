<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.providers.media.vmslowcloud2">
    <uses-permission android:name="com.android.providers.media.permission.MANAGE_CLOUD_MEDIA_PROVIDERS" />
    <application android:label="Picker authorization fixture" android:debuggable="true">
        <provider android:name="com.android.providers.media.vmslowcloud.SlowCloud"
            android:authorities="com.android.providers.media.photopicker:443"
            android:readPermission="com.android.providers.media.permission.MANAGE_CLOUD_MEDIA_PROVIDERS"
            android:forceUriPermissions="true" android:exported="true">
            <intent-filter><action android:name="android.content.action.CLOUD_MEDIA_PROVIDER" /></intent-filter>
        </provider>
        <provider android:name="com.android.providers.media.vmslowcloud.Control"
            android:authorities="com.android.providers.media.vmslowcloud2.control"
            android:permission="com.android.providers.media.permission.MANAGE_CLOUD_MEDIA_PROVIDERS"
            android:exported="true" />
    </application>
</manifest>
